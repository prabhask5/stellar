# Stellar Planner needs NO environment variables. Deploy it, open it, and the
# setup wizard asks for everything and stores it (encrypted) in the /data volume.
#
# Every variable below is optional. When set, it takes precedence over the
# value saved by the wizard, and the wizard shows that field as "set by the server".

# Key that encrypts /data/config.json. If unset, one is generated on first run
# and saved to /data/secret. Setting it here is more secure, because the key
# then lives apart from the data it protects. Use 32+ random characters:
#   openssl rand -base64 48
# Changing it later makes the saved config unreadable (you would run setup again).
APP_SECRET=

# The public address of the app, e.g. https://planner.example.com
# Normally detected from the request (and your proxy's X-Forwarded-* headers).
# Set it if links, cookies or CORS behave as if the app lived at the wrong address.
PUBLIC_APP_URL=

# Your self-hosted Supabase. The base URL only, without /rest/v1 or /auth/v1.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection (optional but recommended). Lets the app run
# migrations by itself and revoke individual devices.
#   postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_URL=

# Forgot your PIN? Set RESET_PIN=true, restart, choose a new PIN in the app,
# then REMOVE this variable and restart again. Your data is not touched.
RESET_PIN=

# Port published on the host by docker-compose.yml (the container listens on 3000).
PORT=3000
