{
  "name": "stellar-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@stellar/web",
    "dev:seed": "node tests/support/seed.ts",
    "build": "turbo run build",
    "build:extension": "turbo run zip --filter=@stellar/extension",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tests",
    "lint": "turbo run lint && eslint tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config tests/vitest.config.ts --project unit",
    "test:db": "vitest run --config tests/vitest.config.ts --project db",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:firefox": "node tests/extension-firefox/smoke.mjs",
    "test:all": "pnpm test && pnpm test:db && pnpm test:e2e && pnpm test:firefox",
    "budgets": "node scripts/check-budgets.mjs",
    "tokens": "pnpm --filter @stellar/ui-tokens generate",
    "screenshots": "playwright test --config tests/support/screenshots.config.ts",
    "stack:up": "docker compose -f dev/supabase/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f dev/supabase/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@stellar/db": "workspace:*",
    "@stellar/shared": "workspace:*",
    "@stellar/ui-tokens": "workspace:*",
    "@stellar/universe": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "selenium-webdriver": "^4.53.0",
    "turbo": "^2.11.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
