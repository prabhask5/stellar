{
  "name": "stellar-planner",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@stellar/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "e2e": "pnpm --filter @stellar/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @stellar/ui-tokens generate",
    "stack:up": "docker compose -f dev/supabase/docker-compose.yml up -d --wait",
    "stack:down": "docker compose -f dev/supabase/docker-compose.yml down -v",
    "build:extension": "turbo run zip --filter=@stellar/extension",
    "openapi": "node scripts/generate-openapi.mts",
    "budgets": "node scripts/check-budgets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
