{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!e2e/**"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {},
    "test": {
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "zip": {
      "dependsOn": ["build"],
      "outputs": [".output/*.zip", "../web/public/extension/*.zip"]
    },
    "@stellar/web#build": {
      "dependsOn": ["^build", "@stellar/extension#zip"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!e2e/**"],
      "outputs": [".next/**", "!.next/cache/**", "public/sw.js"]
    }
  }
}
