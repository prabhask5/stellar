{
  "name": "@stellar/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3 && node scripts/publish-zips.mjs",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke:firefox": "node scripts/firefox-smoke.mjs"
  },
  "dependencies": {
    "@stellar/db": "workspace:*",
    "@stellar/shared": "workspace:*",
    "@stellar/ui-tokens": "workspace:*",
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "selenium-webdriver": "^4.53.0",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
